# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local dev db
*.db
*.db-journal

# OMC 세션 런타임 상태 (세션별로 계속 바뀜)
.omc/

# 포트폴리오용 영상·GIF (용량 커서 저장소에 안 올림)
